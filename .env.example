# Copy to .env and fill in. Never commit .env.
PORT=3000
# The public URL people will use (sign-in messages are bound to this host).
PUBLIC_ORIGIN=http://localhost:3000
# Where the real visitor IP comes from. Behind Cloudflare + cloudflared (the production setup) set CLIENT_IP_HEADER to
# cf-connecting-ip: that header's value is the visitor (checked to be an IP, else the socket), and X-Forwarded-For /
# TRUST_PROXY are ignored. Safe only because the app listens on loopback and the tunnel is the only way in (SECURITY.md).
# IPs are used for rate limits and, as keyed hashes only, for the 7-day IP log and IP bans. Never stored or logged raw.
CLIENT_IP_HEADER=
# Without CLIENT_IP_HEADER: how many proxies sit in front of the app (it only listens on 127.0.0.1). Required when
# PUBLIC_ORIGIN is public: 1 = one reverse proxy (Caddy/nginx), 2 = CDN + proxy. Wrong value = everyone shares one rate limit.
TRUST_PROXY=0
# The company name shown small at the bottom (e.g. "Example Holdings LLC"). Empty = "LLC coming soon".
OPERATOR_NAME=
# Launch switches. 0 = "coming soon" for everyone. 1 = allows the area; the admin panel then opens it.
# Chat rooms (Main, Crypto Builds). 0 = "coming soon" until moderation is ready.
CHAT_OPEN=0
# Accounts: sign-up / sign-in (username + password, Sign in with X when set up) and everything that needs an account
# (ideas, votes, inbox). 0 = "coming soon": the sign-in routes answer "coming soon" for everyone (the admin panel is on
# its own host and needs no account).
ACCOUNTS_OPEN=0
# Sign-up proof of work (leading zero bits of sha256, done in the browser; 16 is about 1-2 s on a phone). Leave unset.
# POW_BITS=16
# Solana RPC, read-only: the staking program's public pool account and the token supply. The public one works but is
# rate limited; a free Helius/Triton key is better.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional: enables the live Holders count.
HELIUS_API_KEY=
# Staking program behind stakethebull.xyz. Total staked is read from its public pool account. Leave as is.
STAKING_PROGRAM=4KgvDmEjPJNtbiVhnZ9Cf1i1vgeZdKrCNKhHVTNTkLWT
# Set to off to stop the block chain message scanner (it is polite: about one request per 30 s).
LORE_WORKER=on

# ---- Sign in with X. OFF until all three are set: then an X button appears next to username/password.
# OAuth 2.0 code + PKCE, scopes `users.read tweet.read` only, one paid call per sign-in (GET /2/users/me), tokens never stored.
# From the X developer portal: a confidential client with the callback below. X_REDIRECT_URI must be https://<public host>/auth/x/callback.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
# Daily cap on X sign-ins (paid API calls). Over the cap the X button hides: "Sign in with X is busy, use username and password."
X_LOGIN_DAILY_CAP=500

# ---- Moderation has no server settings: the rules filter, the admin panel and community reports do the work.
# There is no AI moderator and nothing here contacts an AI provider.

# ---- The admin settings page (private). It lives on its own hostname behind Cloudflare Access; see SECURITY.md.
# Hostname for the panel (e.g. admin.example.com). Empty = no admin host at all. On the public host every admin path is a plain 404.
ADMIN_HOST=
# Your Cloudflare Zero Trust team name: the part before .cloudflareaccess.com. Required for the panel to answer at all.
ACCESS_TEAM=
# The Access application's Audience (AUD) tag, from the Zero Trust dashboard. Tokens for any other application are refused.
ADMIN_ACCESS_AUD=
# sha256 of your lowercase e-mail (printf '%s' 'you@example.com' | sha256sum). The e-mail itself is never stored or logged.
ADMIN_EMAIL_SHA256=
